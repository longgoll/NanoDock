{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NanoDock",
  "version": "0.7.1",
  "identifier": "dev.nanodock.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwOERENDQyMTRCNzdDRDAKUldUUWZMY1VRdFNOMEpCTTNQeHlHcEJrK0RBeHowS1U0N0N5TStUM2F2M3Z1TkZ0cUxIUzhVMksK",
      "endpoints": [
        "https://github.com/longgoll/NanoDock/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
